# Copia in .env (mai committato) per lo stack docker-compose e per l'esecuzione dei test.
# Passphrase per sbloccare i segreti (password DB, SSH) in connections.ini.
# Se il file non ha ancora segreti cifrati, puo' restare vuota.
GUI_MONGO_PASSPHRASE=

# ---------------------------------------------------------------------------
# Stack docker-compose: esposizione di rete e credenziali dei database
# ---------------------------------------------------------------------------
# Le due password sotto sono OBBLIGATORIE: senza, `docker compose up` si ferma
# con un messaggio esplicito. Prima l'immagine partiva con MongoDB senza
# autenticazione e MySQL con root/root, entrambi pubblicati su tutte le
# interfacce: chi raggiungeva la porta scavalcava del tutto CodeDB.
MONGO_ROOT_USER=codedb
MONGO_ROOT_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Indirizzo su cui il compose PUBBLICA le porte. Il default 127.0.0.1 rende lo
# stack raggiungibile solo dalla macchina che lo ospita.
# Per condividere l'istanza con il team: BIND_ADDR=0.0.0.0 — ma allora servono
# anche CODEDB_RBAC=on e un reverse proxy HTTPS davanti (vedi sotto).
BIND_ADDR=127.0.0.1
# Bind separato per MongoDB/MySQL: di norma non c'e' ragione di esporli, CodeDB
# li raggiunge dalla rete interna del compose.
DB_BIND_ADDR=127.0.0.1
# Dichiarazione che davanti a CodeDB c'e' un reverse proxy che termina HTTPS.
# Il server RIFIUTA di partire fuori dal loopback senza questa variabile: su
# HTTP viaggerebbero in chiaro password di accesso, token di sessione,
# passphrase del vault e credenziali dei database.
CODEDB_TRUST_PROXY_TLS=1

# Configurazioni opzionali per l'esecuzione della suite di test E2E (npm run test:e2e:all):
# MongoDB (default host: localhost, port: 27017)
# MYSQL (default host: 127.0.0.1, port: 3306, user: root, password: '')
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# RBAC multi-utente (opzionale). Se CODEDB_RBAC non e' "on" l'app resta
# mono-utente come prima e tutte le variabili sotto vengono ignorate.
# ---------------------------------------------------------------------------
# Attiva autenticazione + autorizzazione (login owner/sottoutenti, API key MCP).
CODEDB_RBAC=off
# Control plane MongoDB dove vivono utenti, ruoli, grant, API key e sessioni.
# E' un DB APPLICATIVO dedicato, distinto dai database che poi ispezioni.
CODEDB_APP_DB_URI=mongodb://localhost:27017
CODEDB_APP_DB_NAME=codedb_rbac
# Isolamento multi-tenant: con RBAC on ogni owner ha il proprio file
# <CODEDB_CONNECTIONS_DIR>/<ownerId>.ini (default: cartella "conns" accanto a
# CODEDB_CONNECTIONS_FILE). Di norma non serve impostarlo.
CODEDB_CONNECTIONS_DIR=
# Provider dei diritti: "local" = self-host/community (nessun billing esterno);
# "external" = SaaS che interroga il sistema di billing (CODEDB_BILLING_URL/KEY).
CODEDB_ENTITLEMENT=local
# Owner creato al primo avvio (bootstrap) quando RBAC e' attivo.
CODEDB_OWNER_EMAIL=
CODEDB_OWNER_PASSWORD=
# Limite sottoutenti col provider "local" (con "external" lo impone il piano).
CODEDB_MAX_SUBUSERS=
# Durata del token di sessione UI in millisecondi (opzionale).
CODEDB_SESSION_TTL_MS=
# Solo con CODEDB_ENTITLEMENT=external: endpoint e chiave del billing esterno.
CODEDB_BILLING_URL=
CODEDB_BILLING_KEY=
