# Copia in .env (mai committato) per lo stack docker-compose e per l'esecuzione dei test.
# Passphrase per sbloccare i segreti (password DB, SSH) in connections.ini.
# Se il file non ha ancora segreti cifrati, puo' restare vuota.
GUI_MONGO_PASSPHRASE=

# Configurazioni opzionali per l'esecuzione della suite di test E2E (npm run test:e2e:all):
# MongoDB (default host: localhost, port: 27017)
# MYSQL (default host: 127.0.0.1, port: 3306, user: root, password: '')
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
