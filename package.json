{
  "name": "codedb",
  "version": "0.1.5-beta.1",
  "description": "DBeaver-like web GUI for MongoDB with real-time socket updates",
  "license": "AGPL-3.0-only",
  "author": "Federico 'Keus' Ferrulli",
  "repository": {
    "type": "git",
    "url": "https://github.com/federicoferrulli/CodeDB.git"
  },
  "main": "electron-main.js",
  "bin": {
    "codedb": "bin/codedb.js",
    "mongo-web-gui": "bin/codedb.js"
  },
  "scripts": {
    "start": "node server.js",
    "start:rbac": "node --env-file=.env server.js",
    "dev": "node --watch server.js",
    "electron:start": "electron .",
    "electron:icons": "node tools/genera-icona.js",
    "build:win": "npm run build:ui && npm run electron:icons && npm run electron:licenza && electron-builder --win --publish never",
    "build:mac": "npm run build:ui && npm run electron:icons && npm run electron:licenza && electron-builder --mac --publish never",
    "build:linux": "npm run build:ui && npm run electron:icons && npm run electron:licenza && electron-builder --linux --publish never",
    "prepare:android": "npm run build:ui && node android/prepare.cjs",
    "build:android": "npm run prepare:android && gradle -p android assembleRelease",
    "build:all": "npm run build:ui && npm run electron:icons && npm run electron:licenza && electron-builder -mwl --publish never",
    "build:dir": "npm run build:ui && npm run electron:icons && npm run electron:licenza && electron-builder --dir --publish never",
    "release:win": "npm run build:ui && npm run electron:icons && npm run electron:licenza && node tools/pubblica.js win",
    "release:mac": "npm run build:ui && npm run electron:icons && npm run electron:licenza && node tools/pubblica.js mac",
    "release:linux": "npm run build:ui && npm run electron:icons && npm run electron:licenza && node tools/pubblica.js linux",
    "dist:win": "npm run build:ui && npm run electron:icons && node tools/build-desktop.mjs win32",
    "dist:mac": "npm run build:ui && npm run electron:icons && node tools/build-desktop.mjs darwin",
    "dist:linux": "npm run build:ui && npm run electron:icons && node tools/build-desktop.mjs linux",
    "backup": "node backup/cli.js",
    "test": "node test/unit.js",
    "test:unit": "node test/unit.js",
    "test:e2e": "node test/e2e.js",
    "test:e2e:all": "node test/all-e2e.js",
    "test:all": "npm test && npm run test:e2e:all",
    "test:e2e:mysql": "node test/e2e-mysql.js",
    "test:e2e:mcp": "node test/e2e-mcp.js",
    "test:e2e:mcp-mysql": "node test/e2e-mcp-mysql.js",
    "test:e2e:backup": "node test/e2e-backup.js",
    "test:e2e:backup-mysql": "node test/e2e-backup-mysql.js",
    "test:e2e:export": "node test/e2e-dbexport.js",
    "test:e2e:query": "node test/e2e-query-engine.js",
    "test:e2e:postgres": "node test/e2e-postgres.js",
    "test:unit:mcp-auth": "node test/unit-mcp-auth.js",
    "test:unit:mcp-payload": "node test/unit-mcp-payload.js",
    "test:unit:tetto-tempo": "node test/unit-tetto-tempo.js",
    "test:e2e:tetto-scrittura": "node test/e2e-tetto-scrittura.js",
    "test:e2e:rbac": "node test/e2e-rbac.js",
    "test:e2e:rbac-mcp": "node test/e2e-rbac-mcp.js",
    "test:e2e:cancel": "node test/e2e-query-cancel.js",
    "test:e2e:playwright": "node test/e2e-playwright.js",
    "test:e2e:tocco": "node test/e2e-tocco-griglia.js",
    "test:e2e:ui": "node test/e2e-avvio-ui.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/crea-collegamento.ps1",
    "shortcut-unix": "bash tools/crea-collegamento.sh",
    "electron:licenza": "node tools/genera-licenza.js",
    "impronte": "node tools/impronte.js",
    "build:linux:docker": "node tools/build-linux-docker.js",
    "test:e2e:tipi-mysql": "node test/e2e-tipi-mysql.js",
    "build:ui": "node tools/build-ui.mjs",
    "dev:ui": "node tools/build-ui.mjs --watch",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "test:e2e:arc": "node test/e2e-arc.js && node test/e2e-arc-griglia.js && node test/e2e-arc-campi.js",
    "test:e2e:arc:regressioni": "node test/arc-regressions.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "bson": "^6.10.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "mongodb": "^6.12.0",
    "mysql2": "^3.22.5",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2"
  },
  "productName": "CodeDB",
  "desktopName": "codedb.desktop",
  "build": {
    "appId": "com.codedb.app",
    "productName": "CodeDB",
    "copyright": "Copyright (c) 2026 Federico Ferrulli",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "federicoferrulli",
        "repo": "CodeDB",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!android/**",
      "!docs/**",
      "!issue/**",
      "!test/**",
      "!tools/**",
      "!test-reports/arc/**",
      "!ui/**",
      "!backups/**",
      "!.git*",
      "!Dockerfile",
      "!docker-compose.yml",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "!.env",
      "!.env.*",
      "!.env.example",
      "!connections.ini",
      "!connections.ini.*",
      "!conns/**",
      "!data/**",
      "!vault.json",
      "!vault.json.*",
      "!vault.*",
      "!provenienza/**",
      "!*.log",
      "!*.log.*",
      "!ui-audit.log",
      "!ui-audit.log.*",
      "!mcp-audit.log",
      "!mcp-audit.log.*"
    ],
    "extraMetadata": {
      "name": "codedb"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeDB",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "CodeDB ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "codedb",
      "synopsis": "GUI web multi-database",
      "maintainer": "Federico Ferrulli",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "syncDesktopName": true
    }
  }
}
